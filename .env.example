# Hosted Supabase project (previews and production).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Local development against the Supabase CLI stack instead:
#
#   npm run db:start     # prints the URL and publishable key
#   npm run db:reset     # applies supabase/migrations from scratch
#
# Requires a container runtime (Docker Desktop, OrbStack, or Colima).
# The local API is plain HTTP on loopback, which readPublicEnv() allows as a
# documented exception; every non-loopback host must still be HTTPS.
#
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
